<?xml version="1.0" encoding="utf-8"?>
<!--
  NationalParks.xsd - CSE445 Assignment 4 (Q1.1)
  Number, Street, City, State, Zip (in this order)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="https://cojim21.github.io/CSE445_Assignment4" targetNamespace="https://cojim21.github.io/CSE445_Assignment4" elementFormDefault="qualified" attributeFormDefault="unqualified">

  <!-- Root element: a list of one or more national parks -->
  <xs:element name="NationalParks">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NationalPark" type="NationalParkType" minOccurs="1" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- One national park: Name, then one or more Phone, then Address (left-to-right order) -->
  <xs:complexType name="NationalParkType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1" />
      <xs:element name="Phone" type="xs:string" minOccurs="1" maxOccurs="unbounded" />
      <xs:element name="Address" type="AddressType" minOccurs="1" maxOccurs="1" />
    </xs:sequence>
    <xs:attribute name="Rating" type="xs:decimal" use="optional" />
  </xs:complexType>

  <!-- Address: five child elements in a fixed order and a required NearestAirport attribute -->
  <xs:complexType name="AddressType">
    <xs:sequence>
      <xs:element name="Number" type="xs:int" />
      <xs:element name="Street" type="xs:string" />
      <xs:element name="City" type="xs:string" />
      <xs:element name="State" type="xs:string" />
      <xs:element name="Zip" type="xs:int" />
    </xs:sequence>
    <!-- Required attribute: name of the closest airport -->
    <xs:attribute name="NearestAirport" type="xs:string" use="required" />
  </xs:complexType>

</xs:schema>
